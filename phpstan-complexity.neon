# Cognitive complexity per method and class — report only until IMP-001-readability-threshold fires
# (QAS-MAINT-readability). Run by `make complexity` and a CI step that does not fail the build.
includes:
    - vendor/tomasvotruba/cognitive-complexity/config/extension.neon

parameters:
    # Only the complexity rules run here: level 0 keeps the type checks of phpstan.neon out of this report.
    level: 0
    paths:
        - src
    cognitive_complexity:
        # Threshold 0 prints the score of every method and class with any branching (the rule reports only
        # values above the threshold); IMP-001 sets the failing threshold after the first product change.
        class: 0
        function: 0
