# Cognitive complexity per method and class (QAS-MAINT-readability). Run by `make complexity`, which is
# part of `make check` (pre-commit and CI): a method or class above the threshold fails the build.
includes:
    - vendor/tomasvotruba/cognitive-complexity/config/extension.neon

parameters:
    # Only the complexity rules run here: level 0 keeps the type checks of phpstan.neon out of this report.
    level: 0
    paths:
        - src
    cognitive_complexity:
        # Owner, 2026-10-07 (IMP-001-readability-threshold): measured on change status-catalog — method
        # maximum 3, class maximum 6; the threshold leaves about twice that as headroom.
        class: 20
        function: 5
