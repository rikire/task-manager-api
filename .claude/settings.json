{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "autoMemoryEnabled": false,
  "attribution": {
    "commit": "Assisted-by: Claude Code",
    "pr": "Assisted-by: Claude Code",
    "sessionUrl": false
  },
  "env": {
    "OPENSPEC_TELEMETRY": "0"
  },
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "WebSearch",
      "Bash(make *)",
      "Bash(openspec *)",
      "Bash(scripts/phase impl)",
      "Bash(scripts/phase refactor)",
      "Bash(scripts/phase off)",
      "Bash(./scripts/phase impl)",
      "Bash(./scripts/phase refactor)",
      "Bash(./scripts/phase off)",
      "Bash(python3 -m unittest *)",
      "Bash(docker compose up*)",
      "Bash(docker compose down*)",
      "Bash(docker compose ps*)",
      "Bash(docker compose logs*)"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)",
      "Bash(scripts/phase tests)",
      "Bash(./scripts/phase tests)",
      "Bash(composer require *)",
      "Bash(composer remove *)",
      "Bash(npm install *)",
      "Bash(mise use *)",
      "Bash(docker compose exec *)",
      "Bash(docker compose run *)",
      "Bash(docker exec *)",
      "Bash(docker run *)",
      "Edit(./composer.json)",
      "Edit(./composer.lock)",
      "Edit(./mise.toml)",
      "Edit(./mise.lock)",
      "Edit(./migrations/**)",
      "Edit(./AGENTS.md)",
      "Edit(./CLAUDE.md)",
      "Edit(./.claude/**)",
      "Edit(./.agents/**)",
      "Edit(./openspec/config.yaml)",
      "Edit(./.github/**)",
      "Edit(./.githooks/**)",
      "Edit(./Makefile)",
      "Edit(./compose.yaml)",
      "Edit(./compose.override.yaml)",
      "Edit(./Dockerfile)",
      "Edit(./docker/**)",
      "Edit(./phpunit.xml.dist)",
      "Edit(./phpstan.neon)",
      "Edit(./psalm.xml)",
      "Edit(./deptrac.yaml)",
      "Edit(./infection.json5)",
      "Edit(./.php-cs-fixer.dist.php)",
      "Edit(./phpstan-complexity.neon)",
      "Edit(./.markdownlint-cli2.jsonc)",
      "Edit(./tools/**)",
      "Edit(./scripts/*.py)"
    ],
    "deny": [
      "Bash(* --no-verify*)",
      "Bash(git commit -n *)",
      "Edit(./.agent-state/phase)",
      "Edit(./docs/registers/traceability.md)",
      "Edit(./docs/adr/README.md)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./secrets/**)"
    ]
  },
  "sandbox": {
    "enabled": false,
    "failIfUnavailable": true,
    "excludedCommands": [
      "make",
      "docker"
    ],
    "network": {
      "allowedDomains": [
        "github.com",
        "api.github.com",
        "codeload.github.com",
        "objects.githubusercontent.com",
        "packagist.org",
        "repo.packagist.org",
        "registry.npmjs.org"
      ]
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/session_start.py",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/protect_tests.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/protect_ask_paths.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/post_edit.py",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/stop_check.py",
            "timeout": 240
          }
        ]
      }
    ]
  }
}
