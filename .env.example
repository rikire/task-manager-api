# Optional overrides for Docker Compose. Copy to `.env` (git-ignored) and change what you need;
# without `.env`, compose.yaml uses the non-secret development defaults shown here.
# Symfony itself does not read .env files (dotenv is disabled, decision record 15): every value reaches
# the application as an environment variable set by Compose.

# Host port of the API (http://localhost:8080).
HTTP_PORT=8080

# Database credentials (development only).
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=app

# Symfony secret; use a random value outside local development, e.g. `openssl rand -hex 32`.
APP_SECRET=dev-only-not-a-secret
