// markdownlint-cli2 configuration (decision record 19; change finish-init, task 5.3).
{
  "config": {
    "default": true,
    // Prose is wrapped at about 105 columns; tables, code and headings are exempt.
    "MD013": { "line_length": 120, "tables": false, "code_blocks": false, "headings": false },
    // Repeated headings are fine in different sections (for example "Decision" under each ADR group).
    "MD024": { "siblings_only": true },
    // Bold lead-ins ("**Task group 1 — …**") are labels, not headings.
    "MD036": false,
    // Table pipe alignment is not enforced: aligned tables make diffs noisy.
    "MD060": false,
    // Skills, agents and rules start with YAML frontmatter, not a heading.
    "MD041": false
  },
  "ignores": [
    "vendor/**",
    "node_modules/**",
    "var/**",
    // History of decisions, frozen at checklist step 14.
    "docs/pre-init/**",
    "openspec/changes/archive/**",
    // Generated by `openspec init`; regenerated, not edited by hand.
    ".claude/skills/openspec-*/**",
    ".claude/commands/opsx/**",
    // Installed unchanged from anthropics/skills (decision record 20).
    ".claude/skills/doc-coauthoring/**",
    // Copy of the upstream command, kept close to it so the diff shows only the project's changes.
    ".claude/commands/security-review.md",
    ".agents/**"
  ]
}
